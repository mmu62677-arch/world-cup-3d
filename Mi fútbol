
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>WORLD CUP FOOTBALL</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101820;color:white;font-family:Arial;text-align:center}
h1{color:#35e879}
#score{font-size:28px;margin:10px}
#field{
 position:relative;width:96%;max-width:700px;height:440px;
 margin:auto;overflow:hidden;border:4px solid white;
 background:repeating-linear-gradient(to bottom,#168b42 0 55px,#117b39 55px 110px);
}
.line{position:absolute;top:50%;width:100%;border-top:2px solid white}
.circle{position:absolute;width:100px;height:100px;border:2px solid white;border-radius:50%;top:50%;left:50%;transform:translate(-50%,-50%)}
.area{position:absolute;left:30%;width:40%;height:55px;border:2px solid white}
.top{top:0;border-top:0}.bottom{bottom:0;border-bottom:0}
.goal{position:absolute;left:38%;width:24%;height:12px;background:white}
.g1{top:0}.g2{bottom:0}
.player{position:absolute;width:25px;height:25px;border:2px solid white;border-radius:50%;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:bold}
.blue{background:#087cff}.red{background:#ed3030}
#ball{position:absolute;width:15px;height:15px;background:white;border:2px solid black;border-radius:50%;transform:translate(-50%,-50%);z-index:5}
.controls{display:grid;grid-template-columns:repeat(3,65px);gap:7px;justify-content:center;margin:15px}
button{padding:14px;background:#168bff;border:0;border-radius:10px;color:white;font-size:20px;font-weight:bold}
#shoot{background:#e64a32}
</style>
</head>
<body>
<h1>🏆 WORLD CUP FOOTBALL</h1>
<div id="score">MÉXICO 0 - 0 RIVAL</div>
<div id="clock">00:00</div>

<div id="field">
 <div class="line"></div>
 <div class="circle"></div>
 <div class="area top"></div>
 <div class="area bottom"></div>
 <div class="goal g1"></div>
 <div class="goal g2"></div>
 <div id="players"></div>
 <div id="ball"></div>
</div>

<div class="controls">
 <span></span><button onclick="move(0,-10)">⬆️</button><span></span>
 <button onclick="move(-10,0)">⬅️</button>
 <button onclick="move(0,10)">⬇️</button>
 <button onclick="move(10,0)">➡️</button>
 <span></span><button id="shoot" onclick="kick()">⚽ TIRAR</button><span></span>
</div>
<p>🔵 MÉXICO | 🔴 RIVAL</p>
<button onclick="resetGame()">🔄 NUEVO PARTIDO</button>

<script>
const field=document.getElementById("field");
const players=document.getElementById("players");
const ball=document.getElementById("ball");
const score=document.getElementById("score");
let team=[],bx=350,by=220,seconds=0;
let goalsBlue=0,goalsRed=0;
let px=350,py=370;
const W=()=>field.clientWidth;
const H=()=>field.clientHeight;

for(let t=0;t<2;t++){
 for(let i=0;i<11;i++){
  let el=document.createElement("div");
  el.className="player "+(t===0?"blue":"red");
  el.textContent=i+1;
  players.appendChild(el);
  team.push({el,t,i});
 }
}

function render(){
 team.forEach(p=>{
  let x,y;
  if(p.t===0){
   x=W()*(.15+(p.i%4)*.23);
   y=H()*(.57+Math.floor(p.i/4)*.13);
   if(p.i===0)y=H()*.91;
  }else{
   x=W()*(.15+(p.i%4)*.23);
   y=H()*(.08+Math.floor(p.i/4)*.13);
   if(p.i===0)y=H()*.09;
  }
  if(p.t===0&&p.i===1){x=px;y=py;}
  p.el.style.left=x+"px";
  p.el.style.top=y+"px";
 });
 ball.style.left=bx+"px";
 ball.style.top=by+"px";
}
function move(dx,dy){
 px=Math.max(15,Math.min(W()-15,px+dx));
 py=Math.max(15,Math.min(H()-15,py+dy));
 if(Math.hypot(px-bx,py-by)<40){bx=px;by=py;}
 render();
}
function kick(){
 let direction=by<H()/2?-1:1;
 bx=Math.max(7,Math.min(W()-7,bx+Math.random()*60-30));
 by+=direction*75;
 if(by<15){goalsBlue++;update();resetBall();}
 if(by>H()-15){goalsRed++;update();resetBall();}
 render();
}
function resetBall(){
 bx=W()/2;by=H()/2;px=W()/2;py=H()*.85;
 render();
}
function update(){
 score.textContent="MÉXICO "+goalsBlue+" - "+goalsRed+" RIVAL";
}
function resetGame(){
 goalsBlue=0;goalsRed=0;seconds=0;
 update();resetBall();
}
setInterval(()=>{
 seconds++;
 document.getElementById("clock").textContent=
 String(Math.floor(seconds/60)).padStart(2,"0")+":"+
 String(seconds%60).padStart(2,"0");
},1000);
render();
</script>
</body>
</html>

